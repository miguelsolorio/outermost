{
  "name": "space-exploration",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A scientifically accurate exploration of the observable universe, from planetary surfaces to the cosmic microwave background.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "doctor": "node tools/doctor.ts",
    "bake": "node tools/bake/run.ts",
    "pipeline": "node tools/pipeline/run.ts",
    "postinstall": "node tools/copy-vendor.ts",
    "pack": "node tools/pack/pack.ts",
    "pull": "node tools/pack/pull.ts"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "fuse.js": "^7.5.0",
    "satellite.js": "^7.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
